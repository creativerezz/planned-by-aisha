# Provisioned by the Vercel Resend integration (`vercel env pull`).
RESEND_API_KEY=

# Where inquiries are delivered. Defaults to SITE.email in lib/content.ts.
INQUIRY_TO_EMAIL=

# Sender identity. Must be an address on a domain verified in Resend.
# Falls back to Resend's shared onboarding sender, which can only deliver
# to the email address that owns the Resend account.
INQUIRY_FROM_EMAIL="Planned by Ayesha <hello@yourdomain.com>"
